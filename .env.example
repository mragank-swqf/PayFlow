# Used by local venv AND docker compose (compose overrides DB/Redis hosts to service names)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=payflow
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=8000

DATABASE_URL=postgresql://postgres:password@localhost:5432/payflow
# ASYNC_DATABASE_URL is derived automatically from DATABASE_URL
REDIS_URL=redis://localhost:6379/0

# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
